{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "NEGATIVE: $ref creates a circular reference back to itself",
  "invalid-color": {
    "$ref": "#/invalid-color/$value",
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0, 0, 0]
    }
  }
}
