{
  "description": "Resolver with sets",
  "name": "Design System Tokens",
  "version": "2025.10",
  "sets": {
    "colors": {
      "sources": [
        {
          "color": {
            "brand": {
              "primary": {
                "$type": "color",
                "$value": {
                  "colorSpace": "srgb",
                  "components": [0.2, 0.4, 0.8]
                }
              }
            }
          }
        }
      ]
    },
    "sizes": {
      "sources": [
        {
          "space": {
            "small": {
              "$type": "dimension",
              "$value": {
                "value": 8,
                "unit": "px"
              }
            }
          }
        }
      ]
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/colors" }, { "$ref": "#/sets/sizes" }]
}
